# Line endings: LF everywhere, also on Windows checkouts (nu, just and YAML care).
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.tape text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary

# Demo recordings (VHS GIFs, screen captures) are big: keep them in Git LFS.
# Enable with `git lfs install` before the first one is committed.
*.gif filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
examples/vhs/generated/*.png filter=lfs diff=lfs merge=lfs -text

# Generated: collapse in diffs and the GitHub language stats.
bun.lock linguist-generated=true
CHANGELOG.md linguist-generated=true
