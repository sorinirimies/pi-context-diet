{
  "name": "pi-context-diet",
  "version": "0.3.5",
  "description": "Pi extension that cuts token spend on long sessions: elides stale tool results from the context, but only when the prompt cache has already gone cold, so it costs nothing. Zero prompt tokens.",
  "keywords": ["pi-package", "pi-extension", "tokens", "context", "cache", "cost", "compaction"],
  "license": "MIT",
  "author": "sorinirimies",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorinirimies/pi-context-diet.git"
  },
  "homepage": "https://github.com/sorinirimies/pi-context-diet#readme",
  "files": ["extensions", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions/context-diet.ts"]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "nu scripts/ci/quality_gate.nu"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
